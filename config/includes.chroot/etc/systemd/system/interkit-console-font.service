[Unit]
Description=interkit: console font (Inter Mono)
After=console-setup.service systemd-vconsole-setup.service
Before=getty.target
ConditionPathExists=/usr/share/consolefonts/InterMono-10x20.psf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/interkit-console-font

[Install]
WantedBy=multi-user.target
