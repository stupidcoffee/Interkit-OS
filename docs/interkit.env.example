# Copy to a USB stick as  interkit.env  (or  .env ), plug it in, then run:  sudo interkit-setup
# interkit-setup finds it, asks once, and uses these answers instead of prompting.
# Plain KEY=VALUE lines only (never executed). The file holds secrets in plain text: delete it from the stick afterwards.
BASE_DOMAIN=example.com
ACME_EMAIL=admin@example.com

# certificates + DNS records through Cloudflare (optional; without these, certificates use the HTTP challenge)
ACME_CHALLENGE=dns-cloudflare
CF_ZONE=example.com
CF_API_TOKEN=
CF_TUNNEL_TOKEN=
DDNS_ENABLE=y

# optional overrides (defaults are mail./chat./derp./fossil.<domain>)
# MAIL_HOST=mail.example.com
# CHAT_HOST=chat.example.com
# DERP_HOST=derp.example.com
# WEB_HOST=fossil.example.com
